# Notification Service Environment Variables

NODE_ENV=development
PORT=3003

# Internal API key — Monitor Service must send this header for alerts
INTERNAL_API_KEY=change_me_internal_api_key

# SMTP — set SMTP_MODE=smtp and fill credentials for real email delivery
# SMTP_MODE=dev logs emails to the console (recommended for local development)
SMTP_MODE=dev
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
