# Auth Service Environment Variables
# Copy to .env and fill in values (match root .env database credentials)

NODE_ENV=development
PORT=3001

# PostgreSQL — connects to auth-db container (exposed on host port 5432)
DB_HOST=localhost
# Use 5434 when auth-db is mapped away from local PostgreSQL on 5432
DB_PORT=5434
DB_USER=auth_user
DB_PASSWORD=change_me_auth_db_password
DB_NAME=auth_db

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
