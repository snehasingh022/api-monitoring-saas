# Monitor Service Environment Variables
# Copy to .env and fill in values (match root .env database credentials)

NODE_ENV=development
PORT=3002

# PostgreSQL — connects to monitor-db container (host port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=monitor_user
DB_PASSWORD=change_me_monitor_db_password
DB_NAME=monitor_db

# Redis — latest check result + dashboard cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
LATEST_RESULT_TTL_SECONDS=300
DASHBOARD_TTL_SECONDS=120

# Background worker — cron runs every minute; each monitor uses its own interval_minutes
MONITOR_CRON_SCHEDULE=* * * * *
MONITOR_CHECK_TIMEOUT_MS=10000

# Notification Service (must match notification-service INTERNAL_API_KEY)
NOTIFICATION_SERVICE_URL=http://localhost:3003
INTERNAL_API_KEY=dev-internal-api-key-change-in-production
