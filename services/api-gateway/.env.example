# API Gateway Environment Variables
# Copy to .env before running the gateway

NODE_ENV=development
PORT=3000

# Downstream service URLs (use Docker service names when running in Compose)
AUTH_SERVICE_URL=http://localhost:3001
MONITOR_SERVICE_URL=http://localhost:3002

# JWT — must match Auth Service secrets
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m

# Redis — rate limiting (use Docker hostname when running in Compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
