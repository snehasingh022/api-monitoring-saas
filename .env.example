# =============================================================================
# API Monitoring SaaS — Root Environment Variables
# Copy this file to .env and fill in the values before running docker compose.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL — Auth Service
# -----------------------------------------------------------------------------
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me_auth_db_password
AUTH_DB_NAME=auth_db
# Host port — 5434 avoids conflict with a local PostgreSQL install on 5432
AUTH_DB_PORT=5434

# -----------------------------------------------------------------------------
# PostgreSQL — Monitor Service
# -----------------------------------------------------------------------------
MONITOR_DB_USER=monitor_user
MONITOR_DB_PASSWORD=change_me_monitor_db_password
MONITOR_DB_NAME=monitor_db

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password

# -----------------------------------------------------------------------------
# JWT (shared between Auth Service and API Gateway)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Service Ports (host-facing)
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=3000
FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# Service URLs (used by API Gateway — Docker hostnames apply in Compose)
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:3001
MONITOR_SERVICE_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# Rate Limiting (API Gateway)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10

# -----------------------------------------------------------------------------
# Notification Service
# -----------------------------------------------------------------------------
SMTP_MODE=dev
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
INTERNAL_API_KEY=dev-internal-api-key-change-in-production
NOTIFICATION_SERVICE_URL=http://localhost:3003
MONITOR_SERVICE_URL=http://localhost:3002
